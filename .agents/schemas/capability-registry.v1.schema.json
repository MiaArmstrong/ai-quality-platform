{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability-registry/v1",
  "type": "object",
  "required": ["schema_version", "capabilities"],
  "properties": {
    "schema_version": {"const": "capability-registry/v1"},
    "capabilities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "category"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
          "category": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "gate_capable": {"type": "boolean", "default": false}
        }, "additionalProperties": false
      }
    }
  }, "additionalProperties": false
}
