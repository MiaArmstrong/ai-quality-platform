{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact-types/v1",
  "type": "object",
  "required": ["schema_version", "artifact_types"],
  "properties": {
    "schema_version": {"const": "artifact-types/v1"},
    "artifact_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    }
  },
  "additionalProperties": false
}
