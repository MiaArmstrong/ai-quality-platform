{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-definition/v1",
  "type": "object",
  "required": ["schema_version", "workflow_id", "initial_node", "required_gates", "nodes", "transitions"],
  "properties": {
    "schema_version": {"const": "workflow-definition/v1"},
    "workflow_id": {"$ref": "#/$defs/id"},
    "initial_node": {"$ref": "#/$defs/id"},
    "required_gates": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "artifacts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "node": {
      "type": "object",
      "required": ["id", "type", "requires", "produces"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "type": {"enum": ["task", "gate", "state", "terminal"]},
        "role_id": {"$ref": "#/$defs/id"}, "gate_type": {"$ref": "#/$defs/id"},
        "state": {"enum": ["CREATED", "CONTEXT_READY", "ROUTED", "RUNNING", "VERIFYING", "AWAITING_HUMAN", "REWORK_REQUIRED", "BLOCKED", "COMPLETED", "FAILED", "CANCELLED", "INSUFFICIENT_EVIDENCE"]},
        "requires": {"$ref": "#/$defs/artifacts"}, "produces": {"$ref": "#/$defs/artifacts"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "task"}}}, "then": {"required": ["role_id"], "not": {"required": ["gate_type"]}}},
        {"if": {"properties": {"type": {"const": "gate"}}}, "then": {"required": ["gate_type"], "not": {"required": ["role_id"]}}},
        {"if": {"properties": {"type": {"enum": ["state", "terminal"]}}}, "then": {"required": ["state"], "not": {"anyOf": [{"required": ["role_id"]}, {"required": ["gate_type"]}]}}}
      ],
      "additionalProperties": false
    },
    "transition": {"type": "object", "required": ["from", "to", "on"], "properties": {"from": {"$ref": "#/$defs/id"}, "to": {"$ref": "#/$defs/id"}, "on": {"enum": ["success", "failure", "approved", "rejected", "rework", "bypass"]}, "bypass_reason_required": {"type": "boolean"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
